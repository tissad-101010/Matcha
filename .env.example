# Copy this file to .env, then replace every change-me value.
APP_ENV=development
APP_PORT=8080
SECRET_KEY=change-me-with-at-least-32-random-characters

POSTGRES_DB=matcha
POSTGRES_USER=matcha
POSTGRES_PASSWORD=change-me-postgres-password

VALKEY_PASSWORD=change-me-valkey-password

MINIO_ROOT_USER=matcha-local-admin
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_REGION=us-east-1

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=matcha@example.test
SMTP_FROM_NAME=Matcha
